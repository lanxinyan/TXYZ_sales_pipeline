# ---- Gmail ----
# OAuth "Desktop app" client downloaded from Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
# Which threads count as candidate sales orders (Gmail search syntax)
GMAIL_QUERY=(subject:Order_ OR subject:"purchase order" OR subject:PO OR "PO number") newer_than:30d -in:sent -category:promotions
# Your company's own domains - emails from these are staff, not customers
INTERNAL_DOMAINS=creative-biostructure.com,pr-abacebiology.com,creative-biomart.com,creative-enzymes.com
# Internal order / quote number format, e.g. CBSRX09242501B-2, CBSXY09012601
ORDER_CODE_REGEX=(?<![A-Za-z0-9])CBS[A-Z]{2}\d{8}[A-Z]?(?:-\d+)?(?![A-Za-z0-9])

# ---- Claude (reads emails + attached PDF quotes/POs) ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# set to false to run on the rule-based parser only
USE_LLM=true

# ---- Zoho CRM ----
# Data center: .com (US), .eu, .in, .com.au, .jp, .com.cn ...
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Status given to new Sales Orders (must exist in your picklist)
ZOHO_SO_STATUS=Created
# Create missing Products automatically; otherwise use ZOHO_GENERIC_PRODUCT_ID for unknown items
ZOHO_AUTO_CREATE_PRODUCTS=true
ZOHO_GENERIC_PRODUCT_ID=

# ---- Pipeline ----
DB_PATH=sales_pipeline.db
# Push orders that pass validation without a human approving them first
AUTO_PUSH=false
