# ---- Gmail ----
# OAuth "Desktop app" client downloaded from Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
# Your address (read from Gmail automatically when empty)
USER_EMAIL=
# Orders, POs, quote requests and website inquiries (Gmail search syntax)
GMAIL_QUERY=(subject:Order_ OR subject:"purchase order" OR subject:PO OR "PO number" OR subject:quote OR subject:quotation OR subject:RFQ OR subject:inquiry OR subject:"Creative Biostructure (ID:" OR from:inquiry@creative-biostructure.com) newer_than:30d -category:promotions
# Conversations to follow up: everything you sent recently
FOLLOWUP_QUERY=in:sent newer_than:60d
# Your company's own domains - emails from these are colleagues, not customers
INTERNAL_DOMAINS=creative-biostructure.com,pr-abacebiology.com,creative-biomart.com,creative-enzymes.com
# Senders that are systems, not customers (the website inquiry form mailer)
SYSTEM_DOMAINS=cd-sciences.info
# Internal order / quote number format, e.g. CBSRX09242501B-2, CBSXY09012601
ORDER_CODE_REGEX=(?<![A-Za-z0-9])CBS[A-Z]{2}\d{8}[A-Z]?(?:-\d+)?(?![A-Za-z0-9])

# ---- Emails you send (always with your OK) ----
SENDER_NAME=Tony
# The number from the order template
SENDER_PHONE=1-631-559-9269
EMAIL_SIGNATURE=Best regards,\n\n{sender_name}
ACCOUNTING_EMAIL=accounting@creative-biomart.com
# Your own copy of the wording (start from src/sales_pipeline/templates.txt)
TEMPLATES_FILE=

# ---- Follow-up rules ----
# Days after the last email to the customer: 1st next day, 2nd in 2 days, 3rd in a week, 4th in a month
FOLLOWUP_DAYS=1,2,7,30
# A customer's first email is answered within this many hours
FIRST_REPLY_HOURS=24
# After the 4th follow-up, suggest closing (不买了) this many days later
CLOSE_AFTER_DAYS=14
# Also record replies you send straight from Gmail as follow-ups in Zoho
LOG_MANUAL_REPLIES=true

# ---- Claude (reads order emails + attached PDF quotes/POs; optional) ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# false = rule-based reading only (no API key needed)
USE_LLM=true

# ---- Zoho CRM ----
# Data center: .com (US), .eu, .in, .com.au, .jp, .com.cn ...
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Where customers live (module API names), searched in this order; new inquiries go into the first.
# Leave empty to find them automatically: the module labelled Inquiries/询价, then Leads, then Contacts.
# `sales-pipeline zoho-setup` prints every module's name next to its API name.
ZOHO_CUSTOMER_MODULES=
# Lifecycle tags (已下单, 不买了 ...): written by `sales-pipeline zoho-setup --write`
ZOHO_TAG_FILE=zoho_tags.json
# Status given to new Sales Orders (must exist in your picklist)
ZOHO_SO_STATUS=Created
# Create missing Products automatically; otherwise use ZOHO_GENERIC_PRODUCT_ID for unknown items
ZOHO_AUTO_CREATE_PRODUCTS=true
ZOHO_GENERIC_PRODUCT_ID=

# ---- Pipeline ----
DB_PATH=sales_pipeline.db
# The dashboard re-reads Gmail this often while it is open
SCAN_INTERVAL_MIN=15
# Push orders that pass validation without a human approving them first (command line `run`)
AUTO_PUSH=false
